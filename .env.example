# ============================================
# Configuración de la API de Invoka (1.0.0)
# ============================================

# Tu clave de API (Panel → Perfil)
INVOKA_API_KEY=tu-api-key-aqui

# URL base de la API
INVOKA_BASE_URL=https://www.invoka.com.ec/api

# Puerto del servidor local
PORT=3000

# Ambiente por defecto (1 = pruebas GRATIS, 2 = producción)
DEFAULT_AMBIENTE=1

# Secret del webhook (opcional, se genera si no lo defines)
WEBHOOK_SECRET=tu-secret-de-al-menos-16-caracteres